# Copy this file to .env and fill in your values.
# .env is ignored by git and docker. Never commit real hosts or credentials.
# Note: keep comments on their own lines. docker --env-file does not strip
# inline comments.

# SAP application server
SAP_HOST=
# ICM port, usually 443<instance> for https or 80<instance> for http
SAP_PORT=44300
# https or http
SAP_PROTOCOL=https
# Client (three digits)
SAP_CLIENT=
SAP_LANGUAGE=EN

# Development user (use a dedicated user with minimal authorizations)
SAP_USER=
SAP_PASSWORD=

# Optional
# SAP_TIMEOUT_MS=30000
# SAP_MCP_POLICY_FILE=/path/to/policy.json
# SAP_MCP_AUDIT_FILE=/path/to/audit.jsonl
